{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/upadrian/ADEL-WAF/schema/event.schema.json",
  "title": "AdelWAF event (one JSON object per line in logs/events.jsonl, or per Redis list item)",
  "type": "object",
  "required": ["contract_version", "ts", "block_id", "action", "category", "ip", "method", "uri"],
  "properties": {
    "contract_version": { "const": 1 },
    "ts": { "type": "string", "format": "date-time" },
    "block_id": { "type": "string", "description": "Reference shown on the block page" },
    "action": { "enum": ["block", "monitor"] },
    "category": { "type": "string" },
    "reason": { "type": "string" },
    "score": { "type": "integer" },
    "status": { "type": "integer" },
    "ip": { "type": "string" },
    "host": { "type": "string" },
    "method": { "type": "string" },
    "uri": { "type": "string" },
    "user_agent": { "type": "string" },
    "matches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "category", "score", "target", "name"],
        "properties": {
          "id": { "type": "string" },
          "category": { "type": "string" },
          "score": { "type": "integer" },
          "target": { "type": "string" },
          "name": { "type": "string" },
          "sample": { "type": "string" }
        }
      }
    },
    "ruleset": { "type": "string", "description": "e.g. default@2.0.0" },
    "engine": { "type": "string" },
    "config_hash": { "type": "string" }
  },
  "additionalProperties": true
}
